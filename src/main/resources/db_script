-- ============================================================================
-- USEFUL VIEWS FOR ANALYTICS
-- ============================================================================

-- View: User Resume Statistics
CREATE OR REPLACE VIEW user_resume_stats AS
SELECT
    u.id AS user_id,
    u.email,
    u.first_name,
    u.last_name,
    COUNT(DISTINCT r.id) AS total_resumes,
    COUNT(DISTINCT CASE WHEN r.is_active THEN r.id END) AS active_resumes,
    COUNT(DISTINCT e.id) AS total_exports,
    MAX(r.created_at) AS last_resume_created,
    MAX(e.exported_at) AS last_export_date
FROM users u
LEFT JOIN resumes r ON u.id = r.user_id
LEFT JOIN resume_exports e ON u.id = e.user_id
GROUP BY u.id, u.email, u.first_name, u.last_name;

-- View: Template Usage Statistics
CREATE OR REPLACE VIEW template_usage_stats AS
SELECT
    t.id AS template_id,
    t.name AS template_name,
    t.category,
    COUNT(DISTINCT r.id) AS times_used,
    COUNT(DISTINCT r.user_id) AS unique_users,
    MAX(r.created_at) AS last_used_date
FROM templates t
LEFT JOIN resumes r ON t.id = r.template_id
GROUP BY t.id, t.name, t.category
ORDER BY times_used DESC;

-- View: Daily Export Statistics
CREATE OR REPLACE VIEW daily_export_stats AS
SELECT
    DATE(exported_at) AS export_date,
    COUNT(*) AS total_exports,
    COUNT(DISTINCT user_id) AS unique_users,
    COUNT(DISTINCT resume_id) AS unique_resumes,
    SUM(file_size_kb) AS total_size_kb
FROM resume_exports
GROUP BY DATE(exported_at)
ORDER BY export_date DESC;

