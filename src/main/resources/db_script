-- Function: Get Resume Completion Percentage
CREATE OR REPLACE FUNCTION get_resume_completion(resume_id_param BIGINT)
RETURNS INTEGER AS $$
DECLARE
    total_sections INTEGER;
    required_sections TEXT[] := ARRAY['PERSONAL_INFO', 'SUMMARY', 'EXPERIENCE', 'EDUCATION', 'SKILLS'];
    completed_sections INTEGER;
BEGIN
    SELECT COUNT(*) INTO completed_sections
    FROM resume_sections
    WHERE resume_id = resume_id_param
    AND section_type = ANY(required_sections)
    AND is_visible = TRUE;

    RETURN (completed_sections * 100) / array_length(required_sections, 1);
END;
$$ LANGUAGE plpgsql;

-- Function: Auto-increment Template Popularity
CREATE OR REPLACE FUNCTION increment_template_popularity()
RETURNS TRIGGER AS $$
BEGIN
    UPDATE templates
    SET popularity_count = popularity_count + 1
    WHERE id = NEW.template_id;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- Trigger to auto-increment template popularity
CREATE TRIGGER trigger_template_popularity
    AFTER INSERT ON resumes
    FOR EACH ROW
    WHEN (NEW.template_id IS NOT NULL)
    EXECUTE FUNCTION increment_template_popularity();

